# Smart Money Follows — Environment Configuration
# Copy to config/.env and fill in your API keys
# Signal sources (SEC EDGAR + House/Senate Stock Watcher) are free, no keys needed

# Tiingo — fundamentals & price data
TIINGO_API_KEY=

# FRED — macro indicators (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Database (SQLite default, swap to PostgreSQL URI for production)
DATABASE_URL=sqlite:///./smart_money.db

# Pipeline
CONVICTION_THRESHOLD=0.6
PIPELINE_MODE=oneshot
SCHEDULE_INTERVAL_MINUTES=60
LOG_LEVEL=INFO

# Slack Bot (Socket Mode) — create app at https://api.slack.com/apps
# Bot Token Scopes: chat:write, app_mentions:read, channels:history
# Enable Socket Mode to get the App-Level Token
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_WEBHOOK_URL=

# Where alerts go: slack (default) or whatsapp
ALERT_CHANNEL=slack

# Daily digest: page linked from the message, and whether scraped congressional
# trades go in the public file (check Capitol Trades' terms before enabling)
DIGEST_URL=https://ericcosta.ca/finalyse
DIGEST_INCLUDE_CONGRESSIONAL=false

# Beta top-10 email — setup steps: docs/BETA_EMAIL_SETUP.md
BUTTONDOWN_API_KEY=
BETA_APPROVED_TAG=beta-approved

# WhatsApp Cloud API — setup steps and required templates: docs/WHATSAPP_SETUP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Recipient in international format, digits only (e.g. 14165551234)
WHATSAPP_TO=
